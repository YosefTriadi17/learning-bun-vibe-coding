{
  "name": "learning-bun-vibe-coding",
  "version": "1.0.0",
  "description": "Learning Bun REST API with ElysiaJS, Drizzle ORM, and MySQL",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.2.0",
    "elysia": "^1.4.28",
    "drizzle-orm": "^0.38.3",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.1"
  }
}
